{
  "id": "dolphin",
  "name": "Dolphin",
  "description": "GameCube and Wii emulator.",
  "homepage": "https://dolphin-emu.org",
  "license": "GPL-2.0-or-later",
  "systems": ["gamecube", "wii"],
  // Dolphin is distributed from its own site (not GitHub). Pinned version; update when a new release comes out.
  "source": {
    "type": "url",
    "version": "2506",
    "url": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}-x64.7z",
    "sha256": null
  },
  "executable": "Dolphin.exe",
  "extract": { "stripRoot": true },
  "postInstall": [
    { "action": "createFile", "path": "portable.txt" }
  ],
  "dependencies": ["vcredist-x64"],
  "launch": [
    { "systems": ["gamecube", "wii"], "args": "-b -e \"{rom}\"" }
  ],
  // Quiet launch: -b hides the main window and skips the updater; no usage-statistics question (not covered by -b),
  // OSD messages or stop confirmation; the game renders in its own full-screen window.
  "defaults": [
    { "file": "User/Config/Dolphin.ini", "format": "ini",
      "settings": {
        "Analytics": { "PermissionAsked": "True", "Enabled": "False" },
        "AutoUpdate": { "UpdateTrack": "" },
        "Interface": { "ConfirmStop": "False", "OnScreenDisplayMessages": "False", "PauseOnFocusLost": "False" },
        "Display": { "Fullscreen": "True", "RenderToMain": "False" } } }
  ],
  // GameCube 1 on the first XInput controller. The Wii Remote stays on the keyboard (map it in Controllers › Wii Remote 1).
  "controller": {
    "file": "User/Config/GCPadNew.ini",
    "format": "ini",
    "description": "Players 1 and 2 · Xbox controller",
    "settings": {
      "GCPad2": {
        "Device": "XInput/1/Gamepad",
        "Buttons/A": "`Button A`", "Buttons/B": "`Button B`", "Buttons/X": "`Button X`", "Buttons/Y": "`Button Y`",
        "Buttons/Z": "`Shoulder R`", "Buttons/Start": "`Start`",
        "Main Stick/Up": "`Left Y+`", "Main Stick/Down": "`Left Y-`", "Main Stick/Left": "`Left X-`", "Main Stick/Right": "`Left X+`",
        "C-Stick/Up": "`Right Y+`", "C-Stick/Down": "`Right Y-`", "C-Stick/Left": "`Right X-`", "C-Stick/Right": "`Right X+`",
        "Triggers/L": "`Trigger L`", "Triggers/R": "`Trigger R`",
        "Triggers/L-Analog": "`Trigger L`", "Triggers/R-Analog": "`Trigger R`",
        "D-Pad/Up": "`Pad N`", "D-Pad/Down": "`Pad S`", "D-Pad/Left": "`Pad W`", "D-Pad/Right": "`Pad E`",
        "Rumble/Motor": "`Motor L` | `Motor R`"
      },
      "GCPad1": {
        "Device": "XInput/0/Gamepad",
        "Buttons/A": "`Button A`", "Buttons/B": "`Button B`", "Buttons/X": "`Button X`", "Buttons/Y": "`Button Y`",
        "Buttons/Z": "`Shoulder R`", "Buttons/Start": "`Start`",
        "Main Stick/Up": "`Left Y+`", "Main Stick/Down": "`Left Y-`", "Main Stick/Left": "`Left X-`", "Main Stick/Right": "`Left X+`",
        "C-Stick/Up": "`Right Y+`", "C-Stick/Down": "`Right Y-`", "C-Stick/Left": "`Right X-`", "C-Stick/Right": "`Right X+`",
        "Triggers/L": "`Trigger L`", "Triggers/R": "`Trigger R`",
        "Triggers/L-Analog": "`Trigger L`", "Triggers/R-Analog": "`Trigger R`",
        "D-Pad/Up": "`Pad N`", "D-Pad/Down": "`Pad S`", "D-Pad/Left": "`Pad W`", "D-Pad/Right": "`Pad E`",
        "Rumble/Motor": "`Motor L` | `Motor R`"
      }
    }
  },
  // Save states: User/StateSaves/GALE01.s01 (disc ID).
  "saves": {
    "states": [ { "dir": "User/StateSaves", "pattern": "{serial}.s*", "slot": "\\.s(\\d+)$" } ],
    "loadStateArgs": "-b -s \"{state}\" -e \"{rom}\"",
    "backup": ["User/GC", "User/Wii", "User/StateSaves"]
  },
  "preserve": ["portable.txt"],
  "graphics": {
    "file": "User/Config/GFX.ini",
    "presets": { "values": {
      "Original": { "Settings": { "InternalResolution": "1", "MSAA": "1" }, "Enhancements": { "MaxAnisotropy": "0" } },
      "Enhanced": { "Settings": { "InternalResolution": "3", "MSAA": "1" }, "Enhancements": { "MaxAnisotropy": "4" } },
      "Maximum": { "Settings": { "InternalResolution": "6", "MSAA": "4" }, "Enhancements": { "MaxAnisotropy": "4" } } } },
    "resolution": { "values": { "1x": { "Settings": { "InternalResolution": "1" } }, "2x": { "Settings": { "InternalResolution": "2" } }, "3x": { "Settings": { "InternalResolution": "3" } }, "4x": { "Settings": { "InternalResolution": "4" } }, "6x": { "Settings": { "InternalResolution": "6" } }, "8x": { "Settings": { "InternalResolution": "8" } } } },
    "aspect": { "values": {
      "Auto": { "Settings": { "AspectRatio": "0" } },
      "4:3": { "Settings": { "AspectRatio": "2" } },
      "16:9": { "Settings": { "AspectRatio": "1" } } } },
    "toggles": [
      { "id": "widescreen", "label": "True widescreen",
        "hint": "Dolphin's widescreen hack (widens the field of view to 16:9).",
        "on": { "Settings": { "wideScreenHack": "True", "AspectRatio": "1" } },
        "off": { "Settings": { "wideScreenHack": "False", "AspectRatio": "0" } } },
      { "id": "hdtextures", "label": "HD textures",
        "hint": "Put the pack in User\\Load\\Textures\\<game ID> (Dolphin folder).",
        "on": { "Settings": { "HiresTextures": "True" } },
        "off": { "Settings": { "HiresTextures": "False" } } }
    ]
  },
  // ── macOS ── Universal app, signed and notarized. portable.txt next to Dolphin.app keeps User/ in this folder.
  "macos": {
    "source": {
      "type": "url",
      "version": "2506",
      "url": "https://dl.dolphin-emu.org/releases/{version}/dolphin-{version}-universal.dmg",
      "sha256": null
    },
    "executable": "Dolphin.app/Contents/MacOS/Dolphin",
    "dependencies": [],
    // macOS has no XInput: Dolphin reads controllers through SDL and addresses them by the name SDL reports.
    "controller": {
      "file": "User/Config/GCPadNew.ini",
      "format": "ini",
      "description": "Players 1 and 2 · SDL controller",
      "settings": {
        "GCPad2": {
          "Device": "SDL/{port1}/{name1}",
          "Buttons/A": "`Button A`", "Buttons/B": "`Button B`", "Buttons/X": "`Button X`", "Buttons/Y": "`Button Y`",
          "Buttons/Z": "`Shoulder R`", "Buttons/Start": "`Start`",
          "Main Stick/Up": "`Left Y+`", "Main Stick/Down": "`Left Y-`", "Main Stick/Left": "`Left X-`", "Main Stick/Right": "`Left X+`",
          "C-Stick/Up": "`Right Y+`", "C-Stick/Down": "`Right Y-`", "C-Stick/Left": "`Right X-`", "C-Stick/Right": "`Right X+`",
          "Triggers/L": "`Trigger L`", "Triggers/R": "`Trigger R`",
          "Triggers/L-Analog": "`Trigger L`", "Triggers/R-Analog": "`Trigger R`",
          "D-Pad/Up": "`Pad N`", "D-Pad/Down": "`Pad S`", "D-Pad/Left": "`Pad W`", "D-Pad/Right": "`Pad E`",
          "Rumble/Motor": "`Motor L` | `Motor R`"
        },
        "GCPad1": {
          "Device": "SDL/{port0}/{name0}",
          "Buttons/A": "`Button A`", "Buttons/B": "`Button B`", "Buttons/X": "`Button X`", "Buttons/Y": "`Button Y`",
          "Buttons/Z": "`Shoulder R`", "Buttons/Start": "`Start`",
          "Main Stick/Up": "`Left Y+`", "Main Stick/Down": "`Left Y-`", "Main Stick/Left": "`Left X-`", "Main Stick/Right": "`Left X+`",
          "C-Stick/Up": "`Right Y+`", "C-Stick/Down": "`Right Y-`", "C-Stick/Left": "`Right X-`", "C-Stick/Right": "`Right X+`",
          "Triggers/L": "`Trigger L`", "Triggers/R": "`Trigger R`",
          "Triggers/L-Analog": "`Trigger L`", "Triggers/R-Analog": "`Trigger R`",
          "D-Pad/Up": "`Pad N`", "D-Pad/Down": "`Pad S`", "D-Pad/Left": "`Pad W`", "D-Pad/Right": "`Pad E`",
          "Rumble/Motor": "`Motor L` | `Motor R`"
        }
      }
    }
  }
}
