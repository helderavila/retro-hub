{
  "id": "pcsx2",
  "name": "PCSX2",
  "description": "PlayStation 2 emulator.",
  "homepage": "https://pcsx2.net",
  "license": "GPL-3.0",
  "systems": ["ps2"],
  // Latest stable release; the hash comes from the asset's "digest" field on GitHub.
  "source": {
    "type": "github",
    "repo": "PCSX2/pcsx2",
    "asset": "windows-x64-Qt\\.7z$"
  },
  "executable": "pcsx2-qt.exe",
  "extract": { "stripRoot": true },
  "postInstall": [
    { "action": "createFile", "path": "portable.ini" }
  ],
  "dependencies": ["vcredist-x64"],
  "biosDir": "bios",
  "launch": [
    { "systems": ["ps2"], "args": "-nogui -fullscreen -- \"{rom}\"" }
  ],
  // Quiet launch: -nogui skips the main window; SettingsVersion = 1 avoids the "reset settings?" prompt and the wizard;
  // no OSD messages (OsdMessagesPos 0 = none), update check or shutdown confirmation.
  "defaults": [
    { "file": "inis/PCSX2.ini", "format": "ini",
      "settings": {
        "UI": { "SettingsVersion": "1", "SetupWizardIncomplete": "false", "ConfirmShutdown": "false", "StartFullscreen": "true",
                "RenderToSeparateWindow": "true", "HideMainWindowWhenRunning": "true", "PauseOnFocusLoss": "false" },
        "EmuCore/GS": { "OsdMessagesPos": "0", "OsdShowIndicators": "false" },
        "Achievements": { "Notifications": "false", "LeaderboardNotifications": "false" },
        "AutoUpdater": { "CheckAtStartup": "false" } } }
  ],
  // Controller on Pad 1 via SDL: Xbox, DualShock/DualSense and most USB controllers.
  "controller": {
    "file": "inis/PCSX2.ini",
    "format": "ini",
    "description": "Players 1 and 2 · DualShock 2 · rumble",
    "settings": {
      "Pad2": {
        "Type": "DualShock2",
        "Up": "SDL-1/DPadUp", "Right": "SDL-1/DPadRight", "Down": "SDL-1/DPadDown", "Left": "SDL-1/DPadLeft",
        "Triangle": "SDL-1/FaceNorth", "Circle": "SDL-1/FaceEast", "Cross": "SDL-1/FaceSouth", "Square": "SDL-1/FaceWest",
        "Select": "SDL-1/Back", "Start": "SDL-1/Start",
        "L1": "SDL-1/LeftShoulder", "R1": "SDL-1/RightShoulder", "L2": "SDL-1/+LeftTrigger", "R2": "SDL-1/+RightTrigger",
        "L3": "SDL-1/LeftStick", "R3": "SDL-1/RightStick",
        "LUp": "SDL-1/-LeftY", "LRight": "SDL-1/+LeftX", "LDown": "SDL-1/+LeftY", "LLeft": "SDL-1/-LeftX",
        "RUp": "SDL-1/-RightY", "RRight": "SDL-1/+RightX", "RDown": "SDL-1/+RightY", "RLeft": "SDL-1/-RightX",
        "Analog": "SDL-1/Guide", "LargeMotor": "SDL-1/LargeMotor", "SmallMotor": "SDL-1/SmallMotor"
      },
      "InputSources": { "SDL": "true", "XInput": "false" },
      "UI": { "SetupWizardIncomplete": "false" },
      "Pad1": {
        "Type": "DualShock2",
        "Up": "SDL-0/DPadUp", "Right": "SDL-0/DPadRight", "Down": "SDL-0/DPadDown", "Left": "SDL-0/DPadLeft",
        "Triangle": "SDL-0/FaceNorth", "Circle": "SDL-0/FaceEast", "Cross": "SDL-0/FaceSouth", "Square": "SDL-0/FaceWest",
        "Select": "SDL-0/Back", "Start": "SDL-0/Start",
        "L1": "SDL-0/LeftShoulder", "R1": "SDL-0/RightShoulder", "L2": "SDL-0/+LeftTrigger", "R2": "SDL-0/+RightTrigger",
        "L3": "SDL-0/LeftStick", "R3": "SDL-0/RightStick",
        "LUp": "SDL-0/-LeftY", "LRight": "SDL-0/+LeftX", "LDown": "SDL-0/+LeftY", "LLeft": "SDL-0/-LeftX",
        "RUp": "SDL-0/-RightY", "RRight": "SDL-0/+RightX", "RDown": "SDL-0/+RightY", "RLeft": "SDL-0/-RightX",
        "Analog": "SDL-0/Guide", "LargeMotor": "SDL-0/LargeMotor", "SmallMotor": "SDL-0/SmallMotor"
      }
    }
  },
  // Save states: sstates/SLUS-20946 (CRC).01.p2s (the .p2s is a zip with Screenshot.png inside).
  "saves": {
    "states": [ { "dir": "sstates", "pattern": "{serial} (*).*.p2s", "slot": "\\.(\\d+)\\.p2s$" } ],
    "loadStateArgs": "-nogui -fullscreen -statefile \"{state}\" -- \"{rom}\"",
    "backup": ["memcards", "sstates"]
  },
  "preserve": ["inis/PCSX2.ini", "portable.ini"],
  "graphics": {
    "file": "inis/PCSX2.ini",
    "presets": { "values": {
      "Original": { "EmuCore/GS": { "upscale_multiplier": "1", "MaxAnisotropy": "0" } },
      "Enhanced": { "EmuCore/GS": { "upscale_multiplier": "3", "MaxAnisotropy": "16" } },
      "Maximum": { "EmuCore/GS": { "upscale_multiplier": "6", "MaxAnisotropy": "16" } } } },
    "resolution": { "values": { "1x": { "EmuCore/GS": { "upscale_multiplier": "1" } }, "2x": { "EmuCore/GS": { "upscale_multiplier": "2" } }, "3x": { "EmuCore/GS": { "upscale_multiplier": "3" } }, "4x": { "EmuCore/GS": { "upscale_multiplier": "4" } }, "6x": { "EmuCore/GS": { "upscale_multiplier": "6" } }, "8x": { "EmuCore/GS": { "upscale_multiplier": "8" } } } },
    "aspect": { "values": {
      "Auto": { "EmuCore/GS": { "AspectRatio": "Auto 4:3/3:2" } },
      "4:3": { "EmuCore/GS": { "AspectRatio": "4:3" } },
      "16:9": { "EmuCore/GS": { "AspectRatio": "16:9" } } } },
    "toggles": [
      { "id": "widescreen", "label": "True widescreen",
        "hint": "Patches that widen the field of view to 16:9 (in games that have a patch).",
        "on": { "EmuCore": { "EnableWideScreenPatches": "true" }, "EmuCore/GS": { "AspectRatio": "16:9" } },
        "off": { "EmuCore": { "EnableWideScreenPatches": "false" }, "EmuCore/GS": { "AspectRatio": "Auto 4:3/3:2" } } },
      { "id": "hdtextures", "label": "HD textures",
        "hint": "Put the pack in textures\\<serial>\\replacements (PCSX2 folder).",
        "on": { "EmuCore/GS": { "LoadTextureReplacements": "true" } },
        "off": { "EmuCore/GS": { "LoadTextureReplacements": "false" } } }
    ]
  },
  // Achievements login is done inside PCSX2 (Settings › Achievements); here we only enable them.
  "achievements": { "file": "inis/PCSX2.ini", "enable": { "Achievements": { "Enabled": "true" } } },
  // ── macOS ── Signed and notarized, but Intel-only: on Apple Silicon it runs through Rosetta 2
  // (macOS offers to install it the first time). portable.txt next to the .app keeps inis, bios, memcards and sstates here.
  "macos": {
    "description": "PlayStation 2 emulator. On Apple Silicon it runs through Rosetta 2.",
    "source": {
      "type": "github",
      "repo": "PCSX2/pcsx2",
      "asset": "macos-Qt\\.tar\\.xz$"
    },
    // The bundle name carries the version (PCSX2-v2.8.2.app).
    "executable": "PCSX2-*.app/Contents/MacOS/PCSX2",
    "postInstall": [
      { "action": "createFile", "path": "portable.txt" }
    ],
    "dependencies": [],
    "preserve": ["portable.txt"]
  }
}
