{
  "id": "ppsspp",
  "name": "PPSSPP",
  "description": "PlayStation Portable emulator.",
  "homepage": "https://www.ppsspp.org",
  "license": "GPL-2.0-or-later",
  "systems": ["psp"],
  // Windows binaries are published on the official site. The zip is already portable (memstick lives in its own folder).
  "source": {
    "type": "url",
    "version": "1.19.3",
    "url": "https://www.ppsspp.org/files/1_19_3/ppsspp_win.zip",
    "sha256": null
  },
  "executable": "PPSSPPWindows64.exe",
  "extract": { "stripRoot": true },
  "postInstall": [],
  "dependencies": [],
  "launch": [
    { "systems": ["psp"], "args": "--fullscreen --escape-exit --pause-menu-exit \"{rom}\"" }
  ],
  // Quiet launch: no notifications (NotificationPos -1 = none), version check or "you have not saved" question;
  // --escape-exit makes Esc close the game, like the other emulators.
  "defaults": [
    { "file": "memstick/PSP/SYSTEM/ppsspp.ini", "format": "ini",
      "settings": {
        "General": { "FirstRun": "False", "NotificationPos": "-1", "CheckForNewVersion": "False",
                     "AskForExitConfirmationAfterSeconds": "0", "PauseOnLostFocus": "False" },
        "Graphics": { "FullScreen": "True" } } }
  ],
  // Save states: memstick/PSP/PPSSPP_STATE/ULUS10041_1.00_0.ppst. PPSSPP cannot load a state from the command line:
  // they show up in the list, and the game opens normally (load it from the emulator menu).
  "saves": {
    "states": [ { "dir": "memstick/PSP/PPSSPP_STATE", "pattern": "{serialNoDash}_*.ppst", "slot": "_(\\d+)\\.ppst$" } ],
    "backup": ["memstick/PSP/SAVEDATA", "memstick/PSP/PPSSPP_STATE"]
  },
  "preserve": [],
  "graphics": {
    "file": "memstick/PSP/SYSTEM/ppsspp.ini",
    "presets": { "values": {
      "Original": { "Graphics": { "InternalResolution": "1", "AnisotropyLevel": "0", "MultiSampleLevel": "0" } },
      "Enhanced": { "Graphics": { "InternalResolution": "3", "AnisotropyLevel": "4", "MultiSampleLevel": "0" } },
      "Maximum": { "Graphics": { "InternalResolution": "8", "AnisotropyLevel": "4", "MultiSampleLevel": "2" } } } },
    "resolution": { "values": { "1x": { "Graphics": { "InternalResolution": "1" } }, "2x": { "Graphics": { "InternalResolution": "2" } }, "3x": { "Graphics": { "InternalResolution": "3" } }, "4x": { "Graphics": { "InternalResolution": "4" } }, "6x": { "Graphics": { "InternalResolution": "6" } }, "4K": { "Graphics": { "InternalResolution": "8" } } } },
    "toggles": [
      { "id": "hdtextures", "label": "HD textures",
        "hint": "Put the pack in memstick\\PSP\\TEXTURES\\<game ID> (PPSSPP folder).",
        "on": { "Graphics": { "ReplaceTextures": "True" } },
        "off": { "Graphics": { "ReplaceTextures": "False" } } }
    ]
  },
  // ── macOS ── Universal app from the official site, signed and notarized. PPSSPP has no portable mode on macOS:
  // it runs with HOME inside this folder, so the memory stick is home/.config/ppsspp (PSP/SYSTEM, PSP/SAVEDATA…).
  "macos": {
    "source": {
      "type": "url",
      "version": "1.20.4",
      "url": "https://www.ppsspp.org/files/1_20_4/PPSSPP_macOS.dmg",
      "sha256": null
    },
    "executable": "PPSSPPSDL.app/Contents/MacOS/PPSSPPSDL",
    "postInstall": [
      { "action": "createDir", "path": "home/.config/ppsspp/PSP/SYSTEM" }
    ],
    "environment": { "HOME": "{emuDir}/home" },
    "dataDir": "home/.config/ppsspp",
    "defaults": [
      { "file": "PSP/SYSTEM/ppsspp.ini", "format": "ini",
        "settings": {
          "General": { "FirstRun": "False", "NotificationPos": "-1", "CheckForNewVersion": "False",
                       "AskForExitConfirmationAfterSeconds": "0", "PauseOnLostFocus": "False" },
          "Graphics": { "FullScreen": "True" } } }
    ],
    "launch": [
      { "systems": ["psp"], "args": "--fullscreen --escape-exit --pause-menu-exit \"{rom}\"" }
    ],
    // Since 1.20, --state=FILE opens the game right at a save state.
    "saves": {
      "states": [ { "dir": "PSP/PPSSPP_STATE", "pattern": "{serialNoDash}_*.ppst", "slot": "_(\\d+)\\.ppst$" } ],
      "loadStateArgs": "--fullscreen --escape-exit --pause-menu-exit --state=\"{state}\" \"{rom}\"",
      "backup": ["PSP/SAVEDATA", "PSP/PPSSPP_STATE"]
    },
    "graphics": {
      "file": "PSP/SYSTEM/ppsspp.ini",
      "presets": { "values": {
        "Original": { "Graphics": { "InternalResolution": "1", "AnisotropyLevel": "0", "MultiSampleLevel": "0" } },
        "Enhanced": { "Graphics": { "InternalResolution": "3", "AnisotropyLevel": "4", "MultiSampleLevel": "0" } },
        "Maximum": { "Graphics": { "InternalResolution": "8", "AnisotropyLevel": "4", "MultiSampleLevel": "2" } } } },
      "resolution": { "values": { "1x": { "Graphics": { "InternalResolution": "1" } }, "2x": { "Graphics": { "InternalResolution": "2" } }, "3x": { "Graphics": { "InternalResolution": "3" } }, "4x": { "Graphics": { "InternalResolution": "4" } }, "6x": { "Graphics": { "InternalResolution": "6" } }, "4K": { "Graphics": { "InternalResolution": "8" } } } },
      "toggles": [
        { "id": "hdtextures", "label": "HD textures",
          "hint": "Put the pack in home/.config/ppsspp/PSP/TEXTURES/<game ID> (PPSSPP folder).",
          "on": { "Graphics": { "ReplaceTextures": "True" } },
          "off": { "Graphics": { "ReplaceTextures": "False" } } }
      ]
    }
  }
}
