{
  "id": "retroarch",
  "name": "RetroArch",
  "description": "libretro frontend — one core per system.",
  "homepage": "https://www.retroarch.com",
  "license": "GPL-3.0",
  "systems": ["nes", "snes", "n64", "gb", "gbc", "gba", "nds", "sms", "genesis", "segacd", "saturn", "dreamcast", "arcade"],
  // The libretro buildbot does not publish a hash: the install is marked as "no hash".
  // To pin it, fill in "sha256" after checking the file manually.
  "source": {
    "type": "url",
    "version": "1.21.0",
    "url": "https://buildbot.libretro.com/stable/{version}/windows/x86_64/RetroArch.7z",
    "sha256": null
  },
  "executable": "retroarch.exe",
  "extract": { "stripRoot": true },
  "postInstall": [
    { "action": "createDir", "path": "system" }
  ],
  "dependencies": [],
  "biosDir": "system",
  "cores": {
    "urlTemplate": "https://buildbot.libretro.com/nightly/windows/x86_64/latest/{core}_libretro.dll.zip",
    "targetDir": "cores"
  },
  "launch": [
    { "systems": ["nes"],               "core": "mesen",            "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["snes"],              "core": "snes9x",           "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["n64"],               "core": "mupen64plus_next", "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["gb", "gbc"],         "core": "gambatte",         "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["gba"],               "core": "mgba",             "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["nds"],               "core": "melondsds",        "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["sms", "genesis", "segacd"], "core": "genesis_plus_gx", "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["saturn"],            "core": "mednafen_saturn",  "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["dreamcast"],         "core": "flycast",          "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" },
    { "systems": ["arcade"],            "core": "fbneo",            "args": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\"" }
  ],
  // RetroArch already recognizes Xbox controllers through its autoconfig profiles; we only ensure the XInput driver.
  "controller": {
    "file": "retroarch.cfg",
    "format": "flat",
    "description": "XInput autoconfig (all cores)",
    "settings": {
      "": { "input_joypad_driver": "xinput", "input_autodetect_enable": "true" }
    }
  },
  // Save states: states/<ROM name>.state, .state1… (with a .png thumbnail next to it). --entryslot loads the slot on start.
  "saves": {
    "states": [ { "dir": "states", "pattern": "{romName}.state*", "slot": "\\.state(\\d*)$" } ],
    "loadStateArgs": "-f -L \"{emuDir}\\cores\\{core}_libretro.dll\" \"{rom}\" --entryslot={slot}",
    "backup": ["saves", "states"]
  },
  "preserve": ["retroarch.cfg"],
  "graphics": {
    "file": "retroarch.cfg",
    "format": "flat",
    "aspect": { "values": {
      "Auto": { "": { "video_aspect_ratio_auto": "true" } },
      "4:3": { "": { "video_aspect_ratio_auto": "false", "aspect_ratio_index": "0" } },
      "16:9": { "": { "video_aspect_ratio_auto": "false", "aspect_ratio_index": "1" } } } },
    "toggles": [
      { "id": "crt", "label": "CRT filter (old TV)",
        "hint": "Scanlines and CRT TV mask in every RetroArch game (crt-aperture shader).",
        "on": { "": { "video_shader_enable": "true", "auto_shaders_enable": "true" } },
        "off": { "": { "video_shader_enable": "false" } },
        "file": { "path": "config/global.slangp", "content": "#reference \"../shaders/shaders_slang/crt/crt-aperture.slangp\"\n" } }
    ]
  },
  "achievements": {
    "file": "retroarch.cfg",
    "format": "flat",
    "takesCredentials": true,
    "enable": { "": { "cheevos_enable": "true", "cheevos_username": "{user}", "cheevos_password": "{password}" } }
  },
  // ── macOS ── Universal app (Apple Silicon + Intel), signed and notarized by libretro.
  // portable.txt next to RetroArch.app keeps config (config/retroarch.cfg), cores, saves and BIOS in this folder.
  // Each key here replaces the one above on macOS.
  "macos": {
    "source": {
      "type": "url",
      "version": "1.22.2",
      "url": "https://buildbot.libretro.com/stable/{version}/apple/osx/universal/RetroArch_Metal.dmg",
      "sha256": null
    },
    "executable": "RetroArch.app/Contents/MacOS/RetroArch",
    "postInstall": [
      { "action": "createFile", "path": "portable.txt" },
      { "action": "createDir", "path": "system" },
      { "action": "createDir", "path": "config" }
    ],
    "cores": {
      "urlTemplate": "https://buildbot.libretro.com/nightly/apple/osx/{arch}/latest/{core}_libretro.dylib.zip",
      "targetDir": "cores"
    },
    "launch": [
      { "systems": ["nes"],               "core": "mesen",            "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["snes"],              "core": "snes9x",           "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["n64"],               "core": "mupen64plus_next", "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["gb", "gbc"],         "core": "gambatte",         "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["gba"],               "core": "mgba",             "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["nds"],               "core": "melondsds",        "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["sms", "genesis", "segacd"], "core": "genesis_plus_gx", "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["saturn"],            "core": "mednafen_saturn",  "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["dreamcast"],         "core": "flycast",          "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" },
      { "systems": ["arcade"],            "core": "fbneo",            "args": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\"" }
    ],
    // N64: the default renderer (GLideN64, OpenGL) draws a black screen on macOS while the game runs.
    // ParaLLEl-RDP on Vulkan (MoltenVK) works and is the most accurate; the override switches only this core to Vulkan.
    "defaults": [
      { "file": "config/Mupen64Plus-Next/Mupen64Plus-Next.opt", "format": "flat",
        "settings": { "": { "mupen64plus-rdp-plugin": "parallel", "mupen64plus-rsp-plugin": "parallel" } } },
      { "file": "config/Mupen64Plus-Next/Mupen64Plus-Next.cfg", "format": "flat",
        "settings": { "": { "video_driver": "vulkan" } } }
    ],
    // macOS has no XInput: the MFi driver (Game Controller framework) reads Xbox, PlayStation and MFi controllers.
    "controller": {
      "file": "config/retroarch.cfg",
      "format": "flat",
      "description": "MFi autoconfig (all cores)",
      "settings": {
        "": { "input_joypad_driver": "mfi", "input_autodetect_enable": "true" }
      }
    },
    "saves": {
      "states": [ { "dir": "states", "pattern": "{romName}.state*", "slot": "\\.state(\\d*)$" } ],
      "loadStateArgs": "-f -L \"{emuDir}/cores/{core}_libretro.dylib\" \"{rom}\" --entryslot={slot}",
      "backup": ["saves", "states"]
    },
    "preserve": ["config/retroarch.cfg", "portable.txt"],
    // The CRT filter toggle is Windows-only: on macOS the slang shaders live inside the app bundle.
    "graphics": {
      "file": "config/retroarch.cfg",
      "format": "flat",
      "aspect": { "values": {
        "Auto": { "": { "video_aspect_ratio_auto": "true" } },
        "4:3": { "": { "video_aspect_ratio_auto": "false", "aspect_ratio_index": "0" } },
        "16:9": { "": { "video_aspect_ratio_auto": "false", "aspect_ratio_index": "1" } } } }
    },
    "achievements": {
      "file": "config/retroarch.cfg",
      "format": "flat",
      "takesCredentials": true,
      "enable": { "": { "cheevos_enable": "true", "cheevos_username": "{user}", "cheevos_password": "{password}" } }
    }
  }
}
