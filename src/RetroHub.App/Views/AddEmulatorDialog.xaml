<Window x:Class="RetroHub.App.Views.AddEmulatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RetroHub.App.Helpers"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Add an emulator that is already on the computer: name, .exe, systems and arguments -->
    <Border Width="600" Margin="24" Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="24,22,24,20">
            <TextBlock Text="{l:T 'Add emulator'}" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{l:T 'Point to the .exe of an emulator you already have. Retro Hub only launches games with it: nothing is downloaded, copied or changed in the emulator folder.'}" />

            <TextBlock Text="{l:T NAME}" Style="{StaticResource Text.Overline}" Margin="0,20,0,6" />
            <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Field}" />

            <TextBlock Text="{l:T EXECUTABLE}" Style="{StaticResource Text.Overline}" Margin="0,16,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="{l:T 'Browse…'}" Margin="8,0,0,0" Click="Browse_Click" />
                <TextBox x:Name="ExeBox" Style="{StaticResource TextBox.Field}" />
            </DockPanel>

            <TextBlock Text="{l:T SYSTEMS}" Style="{StaticResource Text.Overline}" Margin="0,16,0,8" />
            <ItemsControl x:Name="SystemsList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ToggleButton Style="{StaticResource Chip.Toggle}" IsChecked="{Binding IsChecked}" Margin="0,0,6,6" ToolTip="{Binding Name}">
                            <TextBlock Text="{Binding Label}" />
                        </ToggleButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{l:T ARGUMENTS}" Style="{StaticResource Text.Overline}" Margin="0,12,0,6" />
            <TextBox x:Name="ArgsBox" Style="{StaticResource TextBox.Field}" FontFamily="{StaticResource Font.Mono}" Text="&quot;{rom}&quot;" />
            <!-- Text set in code (it has literal braces) -->
            <TextBlock x:Name="ArgsHint" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,6,0,0" TextWrapping="Wrap" />

            <Border x:Name="ErrorBox" Margin="0,14,0,0" Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Md}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" Padding="12,10" Visibility="Collapsed">
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Brush.Status.Error}" FontSize="{StaticResource Font.Size.Sm}" TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T Cancel}" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Style="{StaticResource Button.Primary}" Content="{l:T Add}" IsDefault="True" Click="Add_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
