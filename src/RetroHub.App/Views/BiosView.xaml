<UserControl x:Class="RetroHub.App.Views.BiosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RetroHub.App.Controls"
             AllowDrop="True" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">

    <UserControl.Resources>
        <GridLength x:Key="Col.File">1.3*</GridLength>
        <GridLength x:Key="Col.Hash">1.9*</GridLength>
        <GridLength x:Key="Col.Desc">2*</GridLength>
        <GridLength x:Key="Col.Status">1.8*</GridLength>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Page.Padding}">

            <Grid>
                <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="BIOS" Style="{StaticResource Text.Display}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                               Text="O Retro Hub não baixa BIOS — são firmwares protegidos. Aponte onde estão os dumps do seu console: cada arquivo é reconhecido pelo MD5 (o nome não importa), renomeado e copiado para os emuladores." />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ImportFilesCommand}" Margin="0,0,8,0" Content="Arquivos…" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding ImportFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Download}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Importar BIOS" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Área de soltar -->
            <Border x:Name="DropZone" Margin="0,28,0,0" CornerRadius="{StaticResource Radius.Lg}" Padding="20,18" BorderThickness="1"
                    Background="{StaticResource Brush.Bg.Subtle}">
                <Border.BorderBrush>
                    <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="{StaticResource Brush.Border.Strong}">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,4,4" />
                                            <RectangleGeometry Rect="4,4,4,4" />
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.BorderBrush>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenFolderCommand}" ToolTip="Abrir a pasta de BIOS" Margin="0,0,4,0">
                            <ui:Icon Data="{StaticResource Icon.External}" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource Button.Icon}" Command="{Binding VerifyCommand}" ToolTip="Verificar de novo" Margin="0,0,4,0">
                            <ui:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource Button.Secondary.Small}" Command="{Binding SyncCommand}" Content="Copiar para emuladores" />
                    </StackPanel>
                    <ui:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Download}" Width="18" Height="18"
                             Foreground="{StaticResource Brush.Text.Tertiary}" VerticalAlignment="Center" />
                    <StackPanel Margin="16,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="Arraste pastas, arquivos .bin ou .zip para cá" Foreground="{StaticResource Brush.Text.Secondary}" />
                        <TextBlock Text="{Binding BiosDir}" Margin="0,4,0,0" Style="{StaticResource Text.Mono.Tertiary}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="2,16,0,0">
                <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Brush.Text.Primary}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding BusyText}" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,0,12,0"
                           Visibility="{Binding BusyText, Converter={StaticResource NullToCollapsed}}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Mono.Tertiary}" />
            </StackPanel>
            <TextBlock Margin="2,8,0,0" Style="{StaticResource Text.Mono.Tertiary}">
                <Run Text="sem BIOS necessária ·" /> <Run Text="{Binding NoBiosNeeded, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" />
                <Run Text="   (* BIOS emulada)" />
            </TextBlock>

            <!-- Aviso -->
            <Border Margin="0,16,0,0" Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}"
                    Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="14,0,6,0" MinHeight="40">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" Fill="{Binding Notice.Kind, Converter={StaticResource StatusBrush}}" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding DismissNoticeCommand}">
                        <ui:Icon Data="{StaticResource Icon.X}" Width="12" Height="12" />
                    </Button>
                    <TextBlock Text="{Binding Notice.Message}" Margin="10,10" Style="{StaticResource Text.Secondary}" />
                </DockPanel>
            </Border>

            <!-- Um painel por sistema -->
            <ItemsControl ItemsSource="{Binding Systems}" Margin="0,24,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource Surface}" Margin="0,0,0,16">
                            <StackPanel>
                                <DockPanel Margin="20,14">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="{StaticResource Font.Size.Sm}"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="{StaticResource Font.Weight.Medium}"
                                                       FontSize="{StaticResource Font.Size.Md}" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                                                <TextBlock Text="{Binding ShortName}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Style="{StaticResource Divider}" />

                                <Grid Margin="{StaticResource Row.Padding}" Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Col.File}" />
                                        <ColumnDefinition Width="{StaticResource Col.Hash}" />
                                        <ColumnDefinition Width="{StaticResource Col.Desc}" />
                                        <ColumnDefinition Width="{StaticResource Col.Status}" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ARQUIVO" Style="{StaticResource Text.Overline}" />
                                    <TextBlock Grid.Column="1" Text="MD5" Style="{StaticResource Text.Overline}" />
                                    <TextBlock Grid.Column="2" Text="DESCRIÇÃO" Style="{StaticResource Text.Overline}" />
                                    <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource Text.Overline}" />
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <Border Style="{StaticResource Divider}" />
                                                <Grid Margin="{StaticResource Row.Padding}" MinHeight="44" ToolTip="{Binding FoundPath}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{StaticResource Col.File}" />
                                                        <ColumnDefinition Width="{StaticResource Col.Hash}" />
                                                        <ColumnDefinition Width="{StaticResource Col.Desc}" />
                                                        <ColumnDefinition Width="{StaticResource Col.Status}" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding File}" Style="{StaticResource Text.Mono}"
                                                               Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Md5}" Style="{StaticResource Text.Mono.Tertiary}"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="{StaticResource Font.Size.Sm}"
                                                               Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="{StaticResource Font.Size.Sm}"
                                                                   Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
