<Window x:Class="RetroHub.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RetroHub.App.Helpers"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Themed confirmation dialog: surface, subtle border, primary button on the right -->
    <Border Width="480" Margin="24" Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <StackPanel>
            <StackPanel Margin="24,22,24,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" TextWrapping="Wrap" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />
                <Border x:Name="DetailBox" Margin="0,14,0,0" Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Md}"
                        BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1" Padding="12,10" Visibility="Collapsed">
                    <TextBlock x:Name="DetailText" Style="{StaticResource Text.Mono.Tertiary}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,22,24,20">
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T 'Cancel'}" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" IsDefault="True" Click="Confirm_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
