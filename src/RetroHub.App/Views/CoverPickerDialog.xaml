<Window x:Class="RetroHub.App.Views.CoverPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RetroHub.App.Controls"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Width="820" Height="600" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Border Margin="20" Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="240" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="Trocar capa" Style="{StaticResource Text.Title}" />
            <TextBox x:Name="Query" Grid.Row="1" Style="{StaticResource TextBox.Search}" Tag="Buscar no acervo de capas"
                     Margin="0,16,16,12" TextChanged="Query_TextChanged" />

            <ListBox x:Name="Results" Grid.Row="2" Margin="0,0,16,0" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Results_SelectionChanged"
                     MouseDoubleClick="Use_Click">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row" Padding="10,7" CornerRadius="{StaticResource Radius.Sm}" Background="Transparent" Cursor="Hand">
                                        <TextBlock Text="{Binding}" Foreground="{StaticResource Brush.Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Overlay.Hover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Surface.Raised}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <TextBlock x:Name="Status" Grid.Row="2" Margin="10,8,16,0" VerticalAlignment="Top" Style="{StaticResource Text.Tertiary}" />

            <!-- Prévia -->
            <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Margin="0,16,0,0" CornerRadius="{StaticResource Radius.Md}"
                    Background="{StaticResource Brush.CoverPlaceholder}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                    VerticalAlignment="Top" Height="320">
                <Grid>
                    <TextBlock x:Name="PreviewHint" Text="prévia" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{StaticResource Text.Mono.Tertiary}" />
                    <Image x:Name="Preview" Stretch="Uniform" Margin="6" />
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,0" Click="FromFile_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Imagem do computador…" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Content="Sem capa" Click="None_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancelar" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="UseButton" Style="{StaticResource Button.Primary}" Content="Usar esta capa" IsDefault="True"
                            IsEnabled="False" Click="Use_Click" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
