<UserControl x:Class="RetroHub.App.Views.EmulatorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RetroHub.App.Controls">

    <UserControl.Resources>
        <!-- Colunas compartilhadas entre cabeçalho e linhas -->
        <GridLength x:Key="Col.Check">36</GridLength>
        <GridLength x:Key="Col.Name">2.4*</GridLength>
        <GridLength x:Key="Col.Systems">2*</GridLength>
        <GridLength x:Key="Col.Version">1.3*</GridLength>
        <GridLength x:Key="Col.Status">1.4*</GridLength>
        <GridLength x:Key="Col.Actions">290</GridLength>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Page.Padding}">

            <!-- Cabeçalho -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,24,0">
                    <TextBlock Text="Emuladores" Style="{StaticResource Text.Display}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                               Text="Versões portáteis baixadas das fontes oficiais. O SHA-256 é conferido antes de extrair; dependências são instaladas via winget." />
                </StackPanel>
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ApplyRecommendedGraphicsCommand}" Margin="0,0,8,0"
                            ToolTip="Aplica o nível de qualidade recomendado para a sua placa de vídeo em todos os emuladores instalados">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Tv}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Imagem recomendada" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding CheckUpdatesCommand}" Margin="0,0,8,0"
                            ToolTip="Procura versões novas dos emuladores instalados">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Refresh}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Atualizações" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ConfigureControllerCommand}" Margin="0,0,8,0"
                            ToolTip="Mapeia o controle Xbox no jogador 1 de todos os emuladores instalados">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Gamepad}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Configurar controle" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding CheckDependenciesCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Package}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Dependências" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddEmulatorCommand}" Margin="0,0,8,0"
                            ToolTip="Use um emulador que você já tem no PC (aponte o .exe)">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Adicionar emulador" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Ghost}" Command="{Binding ImportManifestCommand}" Margin="0,0,8,0"
                            ToolTip="Importa um manifesto .json (mesmo formato dos que vêm com o Retro Hub: download, controle, imagem, saves)">
                        <TextBlock Text="Importar .json" />
                    </Button>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding InstallSelectedCommand}"
                            ToolTip="Instala os marcados (ou todos os que faltam, se nenhum estiver marcado)">
                        <StackPanel Orientation="Horizontal">
                            <ui:Icon Data="{StaticResource Icon.Download}" Width="14" Height="14" Margin="0,0,8,0" />
                            <TextBlock Text="Instalar selecionados" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- Painel de instalação -->
            <ContentControl Style="{StaticResource Surface}" Margin="{StaticResource Section.Gap}"
                            Visibility="{Binding ShowPanel, Converter={StaticResource BoolToVisible}}">
                <StackPanel>
                    <Grid Margin="20,16,12,14">
                        <StackPanel>
                            <TextBlock Text="{Binding PanelTitle}" FontWeight="{StaticResource Font.Weight.Medium}" />
                            <TextBlock Text="{Binding Stage}" Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Fraction, StringFormat={}{0:P0}}" Style="{StaticResource Text.Mono}" Margin="0,0,12,0" />
                            <Button Style="{StaticResource Button.Ghost}" Content="Cancelar" Command="{Binding CancelCommand}"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVisible}}" />
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding ClosePanelCommand}" ToolTip="Fechar"
                                    Visibility="{Binding IsInstalling, Converter={StaticResource BoolToCollapsed}}">
                                <ui:Icon Data="{StaticResource Icon.X}" Width="12" Height="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="20,0" />
                    <Border Margin="0,16,0,0" Background="{StaticResource Brush.Bg}" CornerRadius="0,0,11,11"
                            BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="0,1,0,0">
                        <TextBox x:Name="LogBox" Style="{StaticResource TextBox.Log}" Text="{Binding Log, Mode=OneWay}"
                                 Height="200" TextChanged="LogBox_TextChanged" />
                    </Border>
                </StackPanel>
            </ContentControl>

            <!-- Tabela -->
            <ContentControl Style="{StaticResource Surface}" Margin="{StaticResource Section.Gap}">
                <StackPanel>
                    <Grid Margin="{StaticResource Row.Padding}" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.Check}" />
                            <ColumnDefinition Width="{StaticResource Col.Name}" />
                            <ColumnDefinition Width="{StaticResource Col.Systems}" />
                            <ColumnDefinition Width="{StaticResource Col.Version}" />
                            <ColumnDefinition Width="{StaticResource Col.Status}" />
                            <ColumnDefinition Width="{StaticResource Col.Actions}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="EMULADOR" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="2" Text="SISTEMAS" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="3" Text="VERSÃO" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource Text.Overline}" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />

                    <ItemsControl x:Name="Rows" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="Row" Background="Transparent">
                                    <Border x:Name="RowHover" Background="{StaticResource Brush.Overlay.Hover}" Opacity="0" />
                                    <StackPanel>
                                    <Grid Margin="{StaticResource Row.Padding}" MinHeight="68">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Col.Check}" />
                                            <ColumnDefinition Width="{StaticResource Col.Name}" />
                                            <ColumnDefinition Width="{StaticResource Col.Systems}" />
                                            <ColumnDefinition Width="{StaticResource Col.Version}" />
                                            <ColumnDefinition Width="{StaticResource Col.Status}" />
                                            <ColumnDefinition Width="{StaticResource Col.Actions}" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" VerticalAlignment="Center" HorizontalAlignment="Left" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,14,16,14">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="{StaticResource Font.Weight.Medium}" />
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisible}}"
                                                        ToolTip="Adicionado por você (fica fora da pasta do programa: atualizações do Retro Hub não apagam)">
                                                    <TextBlock Text="seu" Style="{StaticResource Badge.Text}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Tertiary}" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding ControllerText}" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding ControllerText}" />
                                        </StackPanel>

                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Systems}" VerticalAlignment="Center" Margin="0,8,12,4">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Badge}" Margin="0,0,4,4">
                                                        <TextBlock Text="{Binding}" Style="{StaticResource Badge.Text}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Grid.Column="3" Text="{Binding VersionText}" Style="{StaticResource Text.Mono}"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                                                    ToolTip="{Binding StatusTooltip}">
                                            <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding StatusKind, Converter={StaticResource StatusBrush}}" />
                                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="{StaticResource Font.Size.Sm}"
                                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <ToggleButton Style="{StaticResource Chip.Toggle}" Margin="0,6,6,0" IsChecked="{Binding ShowSettings}"
                                                          ToolTip="Resolução e proporção de tela"
                                                          Visibility="{Binding HasGraphics, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="Imagem" />
                                            </ToggleButton>
                                            <Button Style="{StaticResource Button.Icon}" Margin="0,0,6,0" ToolTip="Abrir pasta"
                                                    Command="{Binding DataContext.OpenFolderCommand, ElementName=Rows}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisible}}">
                                                <ui:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Button.Secondary.Small}" Content="{Binding ActionLabel}"
                                                    Command="{Binding DataContext.InstallCommand, ElementName=Rows}" CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Icon}" Margin="4,0,0,0" ToolTip="Remover da lista (emulador adicionado por você)"
                                                    Command="{Binding DataContext.RemoveCustomCommand, ElementName=Rows}" CommandParameter="{Binding}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisible}}">
                                                <ui:Icon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Ajustes de imagem -->
                                    <Border Margin="56,0,20,16" Padding="16,12" Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Md}"
                                            BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1"
                                            Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisible}}">
                                        <StackPanel>
                                            <!-- Nível pronto -->
                                            <DockPanel Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="QUALIDADE" Style="{StaticResource Text.Overline}" Width="170" Margin="0,0,0,6" />
                                                <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding PresetChoices}" SelectedItem="{Binding SelectedPreset}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding RecommendedText}" Style="{StaticResource Text.Mono.Tertiary}" Margin="170,0,0,10"
                                                       Visibility="{Binding HasPresets, Converter={StaticResource BoolToVisible}}" />
                                            <DockPanel Visibility="{Binding HasResolution, Converter={StaticResource BoolToVisible}}">
                                                <TextBlock Text="RESOLUÇÃO INTERNA" Style="{StaticResource Text.Overline}" Width="170" Margin="0,0,0,6" />
                                                <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding ResolutionChoices}" SelectedItem="{Binding SelectedResolution}" />
                                            </DockPanel>
                                            <DockPanel Visibility="{Binding HasAspect, Converter={StaticResource BoolToVisible}}" Margin="0,4,0,0">
                                                <TextBlock Text="PROPORÇÃO" Style="{StaticResource Text.Overline}" Width="170" Margin="0,0,0,6" />
                                                <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding AspectChoices}" SelectedItem="{Binding SelectedAspect}" />
                                            </DockPanel>
                                            <!-- Liga/desliga -->
                                            <ItemsControl ItemsSource="{Binding Toggles}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,0,0,10">
                                                            <CheckBox IsChecked="{Binding IsOn}" Content="{Binding Label}" />
                                                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Text.Tertiary}" Margin="30,3,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                                       Text="Vale para todos os jogos deste emulador a partir do próximo jogo (feche o emulador antes de mudar). Resolução maior deixa os jogos 3D mais nítidos; o nível vira personalizado se você mudar a resolução na mão." />
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                    <Border Style="{StaticResource Divider}" VerticalAlignment="Bottom" />
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="1"
                                                                     Duration="{StaticResource Motion.Fast}" EasingFunction="{StaticResource Motion.EaseOut}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="RowHover" Storyboard.TargetProperty="Opacity" To="0"
                                                                     Duration="{StaticResource Motion.Normal}" EasingFunction="{StaticResource Motion.EaseOut}" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>


            <!-- Conquistas -->
            <TextBlock Text="Conquistas (RetroAchievements)" Style="{StaticResource Text.Title}" Margin="0,48,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" MaxWidth="640" HorizontalAlignment="Left"
                       Text="Troféus em jogos antigos. Crie uma conta grátis em retroachievements.org e entre com ela aqui. No RetroArch o login é automático; no PCSX2 e na DuckStation as conquistas são ligadas e você entra uma vez dentro deles." />
            <ContentControl Style="{StaticResource Surface}" Margin="0,20,0,0">
                <StackPanel Margin="20,16">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="220" Margin="0,0,12,0">
                            <TextBlock Text="USUÁRIO" Style="{StaticResource Text.Overline}" Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding AchievementsUser, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="220" Margin="0,0,12,0">
                            <TextBlock Text="SENHA" Style="{StaticResource Text.Overline}" Margin="0,0,0,6" />
                            <PasswordBox x:Name="AchievementsPassword" />
                        </StackPanel>
                        <Button Style="{StaticResource Button.Primary}" VerticalAlignment="Bottom" Content="Ativar conquistas" Click="EnableAchievements_Click" />
                    </StackPanel>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Text="O Retro Hub não guarda sua senha: ela vai só para o arquivo de configuração do RetroArch (retroarch.cfg), que a troca por um token no primeiro login." />
                </StackPanel>
            </ContentControl>        </StackPanel>
    </ScrollViewer>
</UserControl>
