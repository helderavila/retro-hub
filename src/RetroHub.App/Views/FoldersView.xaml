<UserControl x:Class="RetroHub.App.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RetroHub.App.Controls"
             xmlns:l="clr-namespace:RetroHub.App.Helpers">

    <UserControl.Resources>
        <GridLength x:Key="Col.System">1.6*</GridLength>
        <GridLength x:Key="Col.Folders">1.8*</GridLength>
        <GridLength x:Key="Col.Ext">2.4*</GridLength>
        <GridLength x:Key="Col.Emu">1*</GridLength>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Page.Padding}">

            <Grid>
                <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="{l:T Folders}" Style="{StaticResource Text.Display}" />
                    <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0"
                               Text="{l:T 'The scan goes through these folders and identifies each game by its extension, file header and folder name.'}" />
                </StackPanel>
                <Button Style="{StaticResource Button.Primary}" Command="{Binding AddFolderCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="{l:T 'Add folder'}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ROM folders -->
            <ContentControl Style="{StaticResource Surface}" Margin="{StaticResource Section.Gap}">
                <StackPanel>
                    <Grid Margin="{StaticResource Row.Padding}" Height="40">
                        <TextBlock Text="{l:T 'ROM FOLDERS'}" Style="{StaticResource Text.Overline}" />
                    </Grid>
                    <TextBlock Text="{l:T 'No folders yet.'}" Style="{StaticResource Text.Tertiary}" Margin="20,4,20,20"
                               Visibility="{Binding HasFolders, Converter={StaticResource BoolToCollapsed}}" />
                    <ItemsControl x:Name="FolderRows" ItemsSource="{Binding Folders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" />
                                    <DockPanel Margin="{StaticResource Row.Padding}" Height="52">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Icon}" ToolTip="{l:T 'Open in Explorer'}" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.OpenFolderCommand, ElementName=FolderRows}" CommandParameter="{Binding}">
                                                <ui:Icon Data="{StaticResource Icon.External}" Width="14" Height="14" />
                                            </Button>
                                            <Button Style="{StaticResource Button.Icon}" ToolTip="{l:T 'Remove (files are not deleted)'}"
                                                    Command="{Binding DataContext.RemoveFolderCommand, ElementName=FolderRows}" CommandParameter="{Binding}">
                                                <ui:Icon Data="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                            </Button>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Icon Data="{StaticResource Icon.Folder}" Width="14" Height="14" Foreground="{StaticResource Brush.Text.Tertiary}" />
                                            <TextBlock Text="{Binding}" Margin="12,0,0,0" Style="{StaticResource Text.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Recognized systems -->
            <TextBlock Text="{l:T 'Recognized systems'}" Style="{StaticResource Text.Title}" Margin="0,48,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                       Text="{l:T 'Extensions like .iso, .chd and .bin are shared by several systems. When the header is not enough, the folder name decides, so organize them into folders such as ps2\\ and gamecube\\.'}" />

            <ContentControl Style="{StaticResource Surface}" Margin="0,20,0,0">
                <StackPanel>
                    <Grid Margin="{StaticResource Row.Padding}" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource Col.System}" />
                            <ColumnDefinition Width="{StaticResource Col.Folders}" />
                            <ColumnDefinition Width="{StaticResource Col.Ext}" />
                            <ColumnDefinition Width="{StaticResource Col.Emu}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{l:T SYSTEM}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="1" Text="{l:T 'FOLDER NAMES'}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="2" Text="{l:T EXTENSIONS}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="3" Text="{l:T EMULATOR}" Style="{StaticResource Text.Overline}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Systems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource Divider}" />
                                    <Grid Margin="{StaticResource Row.Padding}" MinHeight="44">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{StaticResource Col.System}" />
                                            <ColumnDefinition Width="{StaticResource Col.Folders}" />
                                            <ColumnDefinition Width="{StaticResource Col.Ext}" />
                                            <ColumnDefinition Width="{StaticResource Col.Emu}" />
                                        </Grid.ColumnDefinitions>
                                        <DockPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Border Style="{StaticResource Badge}" Width="44" DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding ShortName}" Style="{StaticResource Badge.Text}" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="12,0,16,0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                        </DockPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Folders}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Extensions}" Style="{StaticResource Text.Mono.Tertiary}" TextWrapping="Wrap" Margin="0,8,12,8" />
                                        <TextBlock Grid.Column="3" Text="{Binding Emulator}" FontSize="{StaticResource Font.Size.Sm}"
                                                   Foreground="{StaticResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

            <!-- Save backup -->
            <TextBlock Text="{l:T 'Save backup'}" Style="{StaticResource Text.Title}" Margin="0,48,0,0" />
            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left"
                       Text="{l:T 'Memory cards, saves and save states from every emulator in a dated .zip. Keep it in a OneDrive or Google Drive folder for a cloud copy. The 10 most recent are kept.'}" />
            <ContentControl Style="{StaticResource Surface}" Margin="0,20,0,0">
                <StackPanel Margin="20,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Icon}" Command="{Binding OpenBackupDirCommand}" ToolTip="{l:T 'Open the backup folder'}" Margin="0,0,4,0">
                                <ui:Icon Data="{StaticResource Icon.External}" Width="14" Height="14" />
                            </Button>
                            <Button Style="{StaticResource Button.Secondary.Small}" Content="{l:T 'Change folder…'}" Command="{Binding ChangeBackupDirCommand}" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding BackupNowCommand}" Height="28" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.Download}" Width="13" Height="13" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Back up now'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BackupDir}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,4,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Margin="0,16,0,0" IsChecked="{Binding AutoBackup}" Content="{l:T 'Automatic backup once a day (when Retro Hub opens)'}" />
                    <TextBlock Text="{Binding BackupNotice.Message}" Margin="30,10,0,0" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                               Visibility="{Binding BackupNotice, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock Text="{l:T 'backing up…'}" Margin="30,10,0,0" Style="{StaticResource Text.Mono.Tertiary}"
                               Visibility="{Binding IsBackingUp, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </ContentControl>

            <!-- Preferences -->
            <TextBlock Text="{l:T Preferences}" Style="{StaticResource Text.Title}" Margin="0,48,0,0" />
            <ContentControl Style="{StaticResource Surface}" Margin="0,20,0,0">
                <StackPanel Margin="20,16">
                    <CheckBox IsChecked="{Binding StartInTv}" Content="{l:T 'Start in TV mode'}" />
                    <TextBlock Text="{l:T 'To use your PC as a console on the TV. B on the controller returns to this screen. You can also open it with F11 or RetroHub.exe --tv.'}"
                               Style="{StaticResource Text.Tertiary}" Margin="30,4,0,0" TextWrapping="Wrap" />

                    <!-- Interface language (applied on restart) -->
                    <DockPanel Margin="0,20,0,0">
                        <TextBlock Text="{l:T LANGUAGE}" Style="{StaticResource Text.Overline}" Width="200" Margin="0,0,0,6" VerticalAlignment="Center" />
                        <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding Languages}" DisplayMemberPath="Name"
                                 SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguage}" />
                    </DockPanel>
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding LanguageRestartNeeded, Converter={StaticResource BoolToVisible}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="{l:T 'Restart now'}"
                                Command="{Binding RestartCommand}" VerticalAlignment="Center" />
                        <TextBlock Text="{l:T 'Restart Retro Hub to change the language.'}" Style="{StaticResource Text.Tertiary}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </ContentControl>

            <!-- Data -->
            <TextBlock Text="{l:T Data}" Style="{StaticResource Text.Title}" Margin="0,48,0,0" />
            <ContentControl Style="{StaticResource Surface}" Margin="0,20,0,0">
                <StackPanel Margin="20,16">
                    <DockPanel>
                        <TextBlock Text="{l:T 'LIBRARY AND EMULATORS'}" Style="{StaticResource Text.Overline}" Width="200" />
                        <TextBlock Text="{Binding DataRoot}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="{l:T MANIFESTS}" Style="{StaticResource Text.Overline}" Width="200" />
                        <TextBlock Text="{Binding ManifestsDir}" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding ManifestWarnings}" Margin="0,12,0,0"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Ellipse Style="{StaticResource StatusDot}" Fill="{StaticResource Brush.Status.Warn}" />
                                    <TextBlock Text="{Binding}" Margin="10,0,0,0" Style="{StaticResource Text.Mono}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ContentControl>

        </StackPanel>
    </ScrollViewer>
</UserControl>
