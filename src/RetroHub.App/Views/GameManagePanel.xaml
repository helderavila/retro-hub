<!-- A game's collections, emulator, file and verification — used on the game page. -->
<UserControl x:Class="RetroHub.App.Views.GameManagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RetroHub.App.Controls"
             xmlns:l="clr-namespace:RetroHub.App.Helpers">
    <StackPanel>
        <!-- Collections -->
        <TextBlock Text="{l:T 'COLLECTIONS'}" Style="{StaticResource Text.Overline}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Collections}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ToggleButton Style="{StaticResource Chip.Toggle}" IsChecked="{Binding IsMember}" Margin="0,0,6,6">
                        <TextBlock Text="{Binding Name}" />
                    </ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <DockPanel Margin="0,0,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="{l:T 'Create'}"
                    Command="{Binding CreateCollectionCommand}" Margin="8,0,0,0" />
            <TextBox Style="{StaticResource TextBox.Field}" Height="28"
                     Text="{Binding NewCollectionName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding CreateCollectionCommand}" />
                </TextBox.InputBindings>
            </TextBox>
        </DockPanel>
        <TextBlock Text="{l:T 'new collection: type the name and press Enter'}" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,4,0,0" />

        <!-- Emulator -->
        <TextBlock Text="{l:T 'OPEN WITH'}" Style="{StaticResource Text.Overline}" Margin="0,28,0,10" />
        <ListBox Style="{StaticResource Chips}" ItemsSource="{Binding EmulatorChoices}" SelectedItem="{Binding SelectedEmulator}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- File -->
        <TextBlock Text="{l:T 'FILE'}" Style="{StaticResource Text.Overline}" Margin="0,22,0,8" />
        <TextBlock Text="{Binding FilePath}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" />
        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Mono.Tertiary}">
            <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text="{Binding SerialText, Mode=OneWay}" />
        </TextBlock>
        <TextBlock Text="{Binding OfficialNameText}" Margin="0,4,0,0" Style="{StaticResource Text.Mono.Tertiary}"
                   TextWrapping="Wrap" Visibility="{Binding OfficialName, Converter={StaticResource NullToCollapsed}}" />
        <Button Style="{StaticResource Button.Secondary.Small}" Command="{Binding ExtractCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"
                Visibility="{Binding IsCompressed, Converter={StaticResource BoolToVisible}}"
                ToolTip="{l:T 'Extracts the game into its system folder; play time and favorites stay'}">
            <StackPanel Orientation="Horizontal">
                <ui:Icon Data="{StaticResource Icon.Package}" Width="12" Height="12" Margin="0,0,6,0" />
                <TextBlock Text="{l:T 'Extract to games folder…'}" />
            </StackPanel>
        </Button>

        <!-- Verification -->
        <Border Margin="0,16,0,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="14,12">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Command="{Binding VerifyCommand}">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{l:T 'Verify file'}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsVerifying}" Value="True">
                                                <Setter Property="Text" Value="{l:T 'Cancel'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" Fill="{Binding VerifyKind, Converter={StaticResource StatusBrush}}" />
                    <TextBlock Text="{Binding VerifyText}" Margin="10,0,12,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Brush.Text.Secondary}" />
                </DockPanel>
                <ProgressBar Margin="0,12,0,0" Minimum="0" Maximum="1" Value="{Binding VerifyProgress, Mode=OneWay}"
                             Visibility="{Binding IsVerifying, Converter={StaticResource BoolToVisible}}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                           Text="{l:T 'Compares the whole file with the official list (No-Intro/Redump). Large discs take a few minutes.'}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
