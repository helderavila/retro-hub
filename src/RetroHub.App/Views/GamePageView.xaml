<!-- Game page: full screen over the library. DataContext = GameDetailsViewModel. -->
<UserControl x:Class="RetroHub.App.Views.GamePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RetroHub.App.Controls"
             xmlns:views="clr-namespace:RetroHub.App.Views"
             xmlns:l="clr-namespace:RetroHub.App.Helpers"
             Background="{StaticResource Brush.Bg}">

    <UserControl.Resources>
        <Style x:Key="Field.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono.Tertiary}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- ═══ Header (like the Steam game page): wide game art with the title on top ═══ -->
                <Grid Height="300" ClipToBounds="True">
                    <Rectangle Opacity="0.75" Margin="-30">
                        <Rectangle.Fill>
                            <ImageBrush ImageSource="{Binding HeroImage}" Stretch="UniformToFill" />
                        </Rectangle.Fill>
                        <Rectangle.Effect>
                            <BlurEffect Radius="14" KernelType="Gaussian" />
                        </Rectangle.Effect>
                    </Rectangle>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="#33000000" />
                                <GradientStop Offset="0.55" Color="#80000000" />
                                <GradientStop Offset="1" Color="{StaticResource Color.Bg}" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <StackPanel Margin="40,0,40,22" VerticalAlignment="Bottom">
                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SystemName}" Style="{StaticResource Badge.Text}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="44" FontWeight="{StaticResource Font.Weight.Semibold}"
                                   Foreground="{StaticResource Brush.Text.Primary}" TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="Black" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Margin="0,8,0,0" FontSize="{StaticResource Font.Size.Md}" Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap">
                            <Run Text="{Binding InfoLine, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding PeopleLine, Mode=OneWay}" Foreground="{StaticResource Brush.Text.Tertiary}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- ═══ Play bar: big button, numbers and actions ═══ -->
                <Border Margin="40,4,40,0" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Lg}" Padding="16,14">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding PlayCommand}" Height="46" Padding="34,0"
                                    FontSize="{StaticResource Font.Size.Lg}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.Play}" Width="14" Height="14" Margin="0,0,10,0"
                                             Foreground="{StaticResource Brush.Text.Inverse}" Fill="{StaticResource Brush.Text.Inverse}" />
                                    <TextBlock Text="{l:T 'PLAY'}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ContinueCommand}" Height="46" Padding="18,0" Margin="10,0,0,0"
                                    Visibility="{Binding CanContinue, Converter={StaticResource BoolToVisible}}" ToolTip="{l:T 'Opens at the most recent save'}">
                                <TextBlock Text="{l:T 'Continue from save'}" />
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Button.Icon}" Width="38" Height="38" Command="{Binding ToggleFavoriteCommand}" ToolTip="{l:T 'Favorite'}" Margin="0,0,2,0">
                                <ui:Icon Data="{StaticResource Icon.Star}" Width="16" Height="16">
                                    <ui:Icon.Style>
                                        <Style TargetType="ui:Icon">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Item.Favorite}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource Brush.Text.Primary}" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Icon.Style>
                                </ui:Icon>
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" Width="38" Height="38" Command="{Binding ChangeCoverCommand}" ToolTip="{l:T 'Change cover'}" Margin="0,0,2,0">
                                <ui:Icon Data="{StaticResource Icon.Library}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" Width="38" Height="38" Command="{Binding CreateShortcutCommand}" ToolTip="{l:T 'Create desktop shortcut'}" Margin="0,0,2,0">
                                <ui:Icon Data="{StaticResource Icon.External}" Width="16" Height="16" />
                            </Button>
                            <Button Style="{StaticResource Button.Icon}" Width="38" Height="38" Command="{Binding OpenFolderCommand}" ToolTip="{l:T 'Open file location'}">
                                <ui:Icon Data="{StaticResource Icon.Folder}" Width="16" Height="16" />
                            </Button>
                        </StackPanel>

                        <!-- Numbers, in the middle -->
                        <WrapPanel VerticalAlignment="Center" Margin="28,0,12,0">
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{l:T 'LAST PLAYED'}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding LastPlayedTile}" FontSize="{StaticResource Font.Size.Md}" FontWeight="{StaticResource Font.Weight.Medium}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{l:T 'PLAY TIME'}" Style="{StaticResource Text.Overline}" />
                                <TextBlock Text="{Binding PlaytimeText}" FontSize="{StaticResource Font.Size.Md}" FontWeight="{StaticResource Font.Weight.Medium}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,32,0">
                                <TextBlock Text="{l:T 'SESSIONS'}" Style="{StaticResource Text.Overline}" />
                                <TextBlock FontSize="{StaticResource Font.Size.Md}" FontWeight="{StaticResource Font.Weight.Medium}" Margin="0,4,0,0">
                                    <Run Text="{Binding SessionCount, Mode=OneWay}" /><Run Text="  ·  " Foreground="{StaticResource Brush.Text.Tertiary}" /><Run Text="{Binding AverageLine, Mode=OneWay}"
                                                                                       Foreground="{StaticResource Brush.Text.Tertiary}" />
                                </TextBlock>
                            </StackPanel>
                        </WrapPanel>
                    </DockPanel>
                </Border>

                <!-- ═══ Body ═══ -->
                <Grid Margin="40,10,40,56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="36" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Margin="2,0,0,0" Style="{StaticResource Text.Mono.Tertiary}">
                            <Run Text="{Binding AddedText, Mode=OneWay}" /><Run Text="{Binding FirstPlayedText, Mode=OneWay}" />
                        </TextBlock>
                        <!-- Notice -->
                        <Border Margin="0,20,0,0" Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}"
                                Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12,0,4,0" MinHeight="36">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Style="{StaticResource StatusDot}" Fill="{Binding Notice.Kind, Converter={StaticResource StatusBrush}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Command="{Binding DismissNoticeCommand}">
                                    <ui:Icon Data="{StaticResource Icon.X}" Width="11" Height="11" />
                                </Button>
                                <TextBlock Text="{Binding Notice.Message}" Margin="10,8" FontSize="{StaticResource Font.Size.Sm}"
                                           Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- About -->
                        <DockPanel Margin="0,36,0,12">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Command="{Binding EditInfoCommand}"
                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}"
                                    ToolTip="{l:T 'Fill in or fix year, genre, developer and synopsis'}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.Edit}" Width="11" Height="11" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Edit info'}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{l:T 'ABOUT'}" Style="{StaticResource Text.Overline}" VerticalAlignment="Center" />
                        </DockPanel>

                        <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToCollapsed}}" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding Description}" FontSize="{StaticResource Font.Size.Md}" LineHeight="23"
                                       Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Style="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                       Visibility="{Binding HasDescription, Converter={StaticResource BoolToCollapsed}}"
                                       Text="{l:T 'No synopsis for this game yet. Use “Edit info” to write one.'}" />
                            <TextBlock Text="{l:T 'fetching info…'}" Style="{StaticResource Text.Mono.Tertiary}" Margin="0,6,0,0"
                                       Visibility="{Binding IsLoadingInfo, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>

                        <!-- Editing -->
                        <ContentControl Style="{StaticResource Surface}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisible}}">
                            <StackPanel Margin="20">
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,12,14">
                                        <TextBlock Text="{l:T 'year'}" Style="{StaticResource Field.Label}" />
                                        <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding EditYear, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,12,14">
                                        <TextBlock Text="{l:T 'genre'}" Style="{StaticResource Field.Label}" />
                                        <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding EditGenre, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{l:T 'players'}" Style="{StaticResource Field.Label}" />
                                        <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding EditPlayers, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,12,14">
                                        <TextBlock Text="{l:T 'developer'}" Style="{StaticResource Field.Label}" />
                                        <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding EditDeveloper, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,14">
                                        <TextBlock Text="{l:T 'publisher'}" Style="{StaticResource Field.Label}" />
                                        <TextBox Style="{StaticResource TextBox.Field}" Text="{Binding EditPublisher, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </UniformGrid>
                                <TextBlock Text="{l:T 'synopsis'}" Style="{StaticResource Field.Label}" />
                                <TextBox Style="{StaticResource TextBox.Area}" MinHeight="140" Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                                    <Button Style="{StaticResource Button.Ghost}" Content="{l:T 'Cancel'}" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource Button.Primary}" Content="{l:T 'Save'}" Command="{Binding SaveInfoCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>

                        <!-- Images -->
                        <StackPanel Visibility="{Binding HasArt, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{l:T 'IMAGES'}" Style="{StaticResource Text.Overline}" Margin="0,36,0,12" />
                            <UniformGrid Columns="2" Margin="0,0,-16,0">
                                <StackPanel Margin="0,0,16,0" Visibility="{Binding TitleImage, Converter={StaticResource NullToCollapsed}}">
                                    <Border CornerRadius="{StaticResource Radius.Lg}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                        <Image Source="{Binding TitleImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="{l:T 'title screen'}" Style="{StaticResource Text.Mono.Tertiary}" Margin="2,8,0,0" />
                                </StackPanel>
                                <StackPanel Margin="0,0,16,0" Visibility="{Binding SnapImage, Converter={StaticResource NullToCollapsed}}">
                                    <Border CornerRadius="{StaticResource Radius.Lg}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" ClipToBounds="True">
                                        <Image Source="{Binding SnapImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                    </Border>
                                    <TextBlock Text="{l:T 'in game'}" Style="{StaticResource Text.Mono.Tertiary}" Margin="2,8,0,0" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Saves -->
                        <StackPanel Visibility="{Binding HasSaves, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{l:T 'SAVES'}" Style="{StaticResource Text.Overline}" Margin="0,36,0,12" />
                            <ItemsControl ItemsSource="{Binding Saves}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="220" Margin="0,0,14,14" Background="{StaticResource Brush.Surface}" BorderBrush="{StaticResource Brush.Border}"
                                                BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}" Padding="8">
                                            <StackPanel>
                                                <Border Height="150" CornerRadius="{StaticResource Radius.Md}" Background="{StaticResource Brush.Bg}" ClipToBounds="True">
                                                    <Grid>
                                                        <ui:Icon Data="{StaticResource Icon.Gamepad}" Width="22" Height="22" Foreground="{StaticResource Brush.Border.Strong}" />
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                    </Grid>
                                                </Border>
                                                <DockPanel Margin="4,10,0,2">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="{l:T 'Load'}"
                                                            VerticalAlignment="Center" Command="{Binding LoadCommand}" ToolTip="{Binding LoadTooltip}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" FontSize="{StaticResource Font.Size.Sm}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding When}" Margin="0,3,0,0" Style="{StaticResource Text.Mono.Tertiary}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- History -->
                        <StackPanel Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisible}}">
                            <TextBlock Text="{l:T 'HISTORY'}" Style="{StaticResource Text.Overline}" Margin="0,36,0,12" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Style="{StaticResource Surface}">
                                    <StackPanel Margin="20,16,20,14">
                                        <TextBlock Text="{l:T 'Last 12 months'}" Style="{StaticResource Text.Title}" FontSize="{StaticResource Font.Size.Md}" />
                                        <ItemsControl ItemsSource="{Binding Months}" Margin="0,16,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}" Margin="3,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="120" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBlock x:Name="Value" Text="{Binding ValueText}" Style="{StaticResource Text.Mono.Tertiary}"
                                                                   HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0" />
                                                        <Border Grid.Row="1" x:Name="Bar" Height="{Binding ColumnHeight}" Width="16" VerticalAlignment="Bottom"
                                                                CornerRadius="4,4,0,0" Background="{StaticResource Brush.Text.Secondary}" />
                                                        <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Brush.Border}" Margin="-3,0" />
                                                        <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Text.Mono.Tertiary}"
                                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Text.Primary}" />
                                                            <Setter TargetName="Value" Property="Opacity" Value="1" />
                                                        </Trigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>
                                <ContentControl Grid.Column="2" Style="{StaticResource Surface}">
                                    <StackPanel Margin="20,16,20,10">
                                        <TextBlock Text="{l:T 'Recent sessions'}" Style="{StaticResource Text.Title}" FontSize="{StaticResource Font.Size.Md}" Margin="0,0,0,12" />
                                        <ItemsControl ItemsSource="{Binding RecentSessions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,8">
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Style="{StaticResource Text.Mono}" />
                                                        <TextBlock Text="{Binding When}" Style="{StaticResource Text.Mono.Tertiary}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ContentControl>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- ═══ Side column ═══ -->
                    <StackPanel Grid.Column="2">
                        <ContentControl Style="{StaticResource Surface}">
                            <StackPanel Margin="20,16,20,8">
                                <TextBlock Text="{l:T 'DETAILS'}" Style="{StaticResource Text.Overline}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding Facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Tertiary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"
                                                           FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Brush.Text.Primary}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>

                        <TextBlock Text="{l:T 'ON THE WEB'}" Style="{StaticResource Text.Overline}" Margin="0,28,0,10" />
                        <WrapPanel>
                            <Button Style="{StaticResource Button.Secondary.Small}" Command="{Binding OpenWebCommand}" CommandParameter="youtube" Margin="0,0,8,8"
                                    ToolTip="{l:T 'Gameplay videos on YouTube'}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.Play}" Width="10" Height="10" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Gameplay'}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary.Small}" Command="{Binding OpenWebCommand}" CommandParameter="wikipedia" Margin="0,0,8,8"
                                    ToolTip="{l:T 'Wikipedia article'}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.External}" Width="10" Height="10" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Wikipedia'}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Secondary.Small}" Command="{Binding OpenWebCommand}" CommandParameter="guide" Margin="0,0,8,8"
                                    ToolTip="{l:T 'Walkthroughs and guides'}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.Search}" Width="10" Height="10" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Walkthrough'}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <views:GameManagePanel Margin="0,28,0,0" />

                        <WrapPanel Margin="0,28,0,0">
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding RemoveCommand}" Margin="-10,0,8,0"
                                    ToolTip="{l:T 'Removes it from the list; the file stays on disk'}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.X}" Width="12" Height="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Remove from library'}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Ghost}" Command="{Binding DeleteCommand}" Foreground="{StaticResource Brush.Status.Error}"
                                    ToolTip="{l:T 'Sends the file to the Recycle Bin'}">
                                <StackPanel Orientation="Horizontal">
                                    <ui:Icon Data="{StaticResource Icon.Trash}" Width="12" Height="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T 'Delete file'}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Back (pinned to the corner) -->
        <Button Style="{StaticResource Button.Secondary}" Command="{Binding CloseCommand}" HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="20,16,0,0" Background="#99000000" ToolTip="{l:T 'Back to home (Esc)'}">
            <StackPanel Orientation="Horizontal">
                <ui:Icon Data="{StaticResource Icon.ArrowLeft}" Width="14" Height="14" Margin="0,0,8,0" />
                <TextBlock Text="{l:T 'Home'}" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
