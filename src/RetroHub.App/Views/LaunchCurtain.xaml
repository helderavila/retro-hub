<!-- Shown from "Play" until the emulator's window is up: hides the emulator's own windows and transitions. -->
<Window x:Class="RetroHub.App.Views.LaunchCurtain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RetroHub.App.Controls"
        xmlns:l="clr-namespace:RetroHub.App.Helpers"
        WindowStyle="None" ResizeMode="NoResize" WindowState="Maximized" ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="{StaticResource Brush.Bg}" Foreground="{StaticResource Brush.Text.Primary}"
        FontFamily="{StaticResource Font.Sans}" Cursor="None" Opacity="0" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Soft pulse on the status dot while the emulator starts -->
        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="Opacity" From="0.25" To="1" Duration="0:0:1.2" />
        </Storyboard>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <!-- The game's art, blurred, as in TV mode -->
        <Image Source="{Binding CoverImage}" Stretch="UniformToFill" Opacity="0.28" RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
            </Image.RenderTransform>
            <Image.Effect>
                <BlurEffect Radius="90" KernelType="Gaussian" RenderingBias="Performance" />
            </Image.Effect>
        </Image>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.7" RadiusY="0.7">
                    <GradientStop Color="#33000000" Offset="0" />
                    <GradientStop Color="#F2000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="208" Height="278" CornerRadius="14" HorizontalAlignment="Center"
                    Background="{StaticResource Brush.CoverPlaceholder}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="60" ShadowDepth="10" Opacity="0.7" Color="Black" />
                </Border.Effect>
                <Grid>
                    <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="{StaticResource Font.Mono}" FontSize="44" Foreground="{StaticResource Brush.Border.Strong}"
                               Visibility="{Binding HasCover, Converter={StaticResource BoolToCollapsed}}" />
                    <ui:CoverArt CornerRadius="13" Source="{Binding CoverImage}"
                                 Visibility="{Binding HasCover, Converter={StaticResource BoolToVisible}}" />
                </Grid>
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="900" Margin="0,32,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Ellipse x:Name="Dot" Style="{StaticResource StatusDot}" Fill="{StaticResource Brush.Text.Primary}" Margin="0,0,10,0" />
                <TextBlock Style="{StaticResource Text.Mono}" FontSize="{StaticResource Font.Size.Md}">
                    <Run Text="{Binding SystemName, Mode=OneWay}" /><Run Text=" · " Foreground="{StaticResource Brush.Text.Tertiary}" /><Run Text="{l:T 'starting…'}" />
                </TextBlock>
            </StackPanel>
            <!-- Set from code when a controller may not last the session -->
            <StackPanel x:Name="BatteryWarning" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0" Visibility="Collapsed">
                <ui:Icon Data="{StaticResource Icon.Battery}" Width="18" Height="18" Foreground="{StaticResource Brush.Status.Warn}" />
                <TextBlock x:Name="BatteryWarningText" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Mono}"
                           FontSize="{StaticResource Font.Size.Md}" Foreground="{StaticResource Brush.Status.Warn}" />
            </StackPanel>
        </StackPanel>

        <Rectangle x:Name="Grain" IsHitTestVisible="False" />
    </Grid>
</Window>
