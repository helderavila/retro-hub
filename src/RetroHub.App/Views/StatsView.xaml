<UserControl x:Class="RetroHub.App.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:RetroHub.App.Controls"
             xmlns:l="clr-namespace:RetroHub.App.Helpers">

    <UserControl.Resources>
        <!-- Horizontal bar: one series, one neutral tone; the value written beside it (text token, not the bar color) -->
        <DataTemplate x:Key="HBar">
            <Grid Margin="0,0,0,10" Background="Transparent" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- The bar takes "ratio" of the space; the rest stays empty -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}}" />
                        <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource RatioToStar}, ConverterParameter=rest}" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Bar" Height="10" CornerRadius="0,4,4,0" MinWidth="3" Background="{StaticResource Brush.Text.Secondary}" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource Text.Mono}" HorizontalAlignment="Right" />
            </Grid>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Text.Primary}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="{StaticResource Page.Padding}">
            <TextBlock Text="{l:T Stats}" Style="{StaticResource Text.Display}" />
            <TextBlock Text="{l:T 'Based on how long each emulator stays open through Retro Hub (sessions under 10 s do not count).'}"
                       Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" MaxWidth="620" HorizontalAlignment="Left" />

            <!-- Empty -->
            <ContentControl Style="{StaticResource Surface}" Margin="0,32,0,0"
                            Visibility="{Binding HasData, Converter={StaticResource BoolToCollapsed}}">
                <StackPanel Margin="24,28" HorizontalAlignment="Center">
                    <ui:Icon Data="{StaticResource Icon.Chart}" Width="24" Height="24" Foreground="{StaticResource Brush.Text.Tertiary}" />
                    <TextBlock Text="{l:T 'No playtime yet'}" Style="{StaticResource Text.Title}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{l:T 'Play something through Retro Hub and come back here.'}" Style="{StaticResource Text.Tertiary}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </ContentControl>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVisible}}">
                <!-- Totals -->
                <UniformGrid Columns="4" Margin="0,32,-16,0">
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'TOTAL TIME'}" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding TotalTime}" Style="{StaticResource Tile.Value}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'LAST 7 DAYS'}" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding WeekTime}" Style="{StaticResource Tile.Value}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{l:T 'GAMES PLAYED'}" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding GamesPlayed}" Style="{StaticResource Tile.Value}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Tile}">
                        <StackPanel>
                            <TextBlock Text="{l:T SESSIONS}" Style="{StaticResource Text.Overline}" />
                            <TextBlock Text="{Binding Sessions}" Style="{StaticResource Tile.Value}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Last 14 days (columns) -->
                <ContentControl Style="{StaticResource Surface}" Margin="0,24,0,0">
                    <StackPanel Margin="24,20,24,16">
                        <TextBlock Text="{l:T 'Last 14 days'}" Style="{StaticResource Text.Title}" FontSize="{StaticResource Font.Size.Md}" />
                        <ItemsControl ItemsSource="{Binding LastDays}" Margin="0,18,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="Transparent" ToolTip="{Binding Tooltip}" Margin="3,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="120" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="Value" Text="{Binding ValueText}" Style="{StaticResource Text.Mono.Tertiary}"
                                                   HorizontalAlignment="Center" Margin="0,0,0,6" Opacity="0" />
                                        <Border Grid.Row="1" x:Name="Bar" Height="{Binding ColumnHeight}" Width="18" VerticalAlignment="Bottom"
                                                CornerRadius="4,4,0,0" Background="{StaticResource Brush.Text.Secondary}" />
                                        <Border Grid.Row="1" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Brush.Border}" Margin="-3,0" />
                                        <TextBlock Grid.Row="2" Text="{Binding Label}" Style="{StaticResource Text.Mono.Tertiary}"
                                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Brush.Text.Primary}" />
                                            <Setter TargetName="Value" Property="Opacity" Value="1" />
                                        </Trigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <!-- Per system · most played -->
                <Grid Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ContentControl Style="{StaticResource Surface}">
                        <StackPanel Margin="24,20,24,12">
                            <TextBlock Text="{l:T 'Time per system'}" Style="{StaticResource Text.Title}" FontSize="{StaticResource Font.Size.Md}" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding BySystem}" ItemTemplate="{StaticResource HBar}" />
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Grid.Column="2" Style="{StaticResource Surface}">
                        <StackPanel Margin="24,20,24,12">
                            <TextBlock Text="{l:T 'Most played'}" Style="{StaticResource Text.Title}" FontSize="{StaticResource Font.Size.Md}" Margin="0,0,0,16" />
                            <ItemsControl ItemsSource="{Binding TopGames}" ItemTemplate="{StaticResource HBar}" />
                        </StackPanel>
                    </ContentControl>
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
