<Window x:Class="RetroHub.App.Views.UnpackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:RetroHub.App.Controls"
        xmlns:l="clr-namespace:RetroHub.App.Helpers"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Width="880" Height="660" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource Font.Sans}" Foreground="{StaticResource Brush.Text.Primary}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <!-- Extract compressed games: list · games folder · what happens to the archive · progress -->
    <Border Margin="20" Background="{StaticResource Brush.Surface}" CornerRadius="{StaticResource Radius.Lg}"
            BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.6" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Margin="24,20,24,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" Style="{StaticResource Text.Mono.Tertiary}" VerticalAlignment="Center" />
                <TextBlock Text="{l:T 'Extract compressed games'}" Style="{StaticResource Text.Title}" />
            </DockPanel>
            <TextBlock Grid.Row="1" Margin="24,8,24,14" Style="{StaticResource Text.Secondary}"
                       Text="{l:T 'Discs in .zip/.7z do not open in DuckStation, PCSX2, Dolphin or PPSSPP. Each game goes to its system folder; play time, favorites and covers stay.'}" />

            <!-- List -->
            <Border Grid.Row="2" Margin="24,0" Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Md}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="14,0" Height="36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource Button.Icon}" Command="{Binding SelectAllCommand}" ToolTip="{l:T 'Select all / none'}"
                                Width="22" Height="22" HorizontalAlignment="Left">
                            <ui:Icon Data="{StaticResource Icon.Check}" Width="12" Height="12" />
                        </Button>
                        <TextBlock Grid.Column="1" Text="{l:T FILE}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="2" Text="{l:T SYSTEM}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="3" Text="{l:T SIZE}" Style="{StaticResource Text.Overline}" />
                        <TextBlock Grid.Column="4" Text="{l:T DESTINATION}" Style="{StaticResource Text.Overline}" />
                    </Grid>
                    <Border DockPanel.Dock="Top" Style="{StaticResource Divider}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Margin="14,18" Visibility="{Binding HasRows, Converter={StaticResource BoolToCollapsed}}">
                                <TextBlock Text="{l:T 'No compressed games in the library.'}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{l:T 'Use Add files… to pick .zip or .7z games from any folder, such as Downloads.'}"
                                           Style="{StaticResource Text.Tertiary}" Margin="0,4,0,0" />
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid x:Name="Row" Margin="14,0" MinHeight="40" ToolTip="{Binding Game.Path}" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="84" />
                                                <ColumnDefinition Width="1.1*" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanExtract}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource Text.Mono}"
                                                       Foreground="{StaticResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <Border Grid.Column="2" Style="{StaticResource Badge}"
                                                    Visibility="{Binding NeedsSystem, Converter={StaticResource BoolToCollapsed}}">
                                                <TextBlock Text="{Binding SystemShort}" Style="{StaticResource Badge.Text}" />
                                            </Border>
                                            <!-- Picked file the scanner could not place: detect from the disc, or choose -->
                                            <ComboBox Grid.Column="2" ItemsSource="{Binding Systems}" SelectedItem="{Binding SelectedSystem}"
                                                      DisplayMemberPath="Label" Height="26" Margin="0,0,12,0" VerticalAlignment="Center"
                                                      FontSize="{StaticResource Font.Size.Sm}"
                                                      Visibility="{Binding NeedsSystem, Converter={StaticResource BoolToVisible}}" />
                                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Text.Mono.Tertiary}" />
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0"
                                                         Fill="{Binding ResultKind, Converter={StaticResource StatusBrush}}"
                                                         Visibility="{Binding ResultKind, Converter={StaticResource NullToCollapsed}}" />
                                                <TextBlock Text="{Binding Note}" FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Brush.Text.Secondary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                           Visibility="{Binding ResultKind, Converter={StaticResource NullToVisible}}" />
                                                <TextBlock Text="{Binding Result}" FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Brush.Text.Secondary}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Result}"
                                                           Visibility="{Binding ResultKind, Converter={StaticResource NullToCollapsed}}" />
                                            </StackPanel>
                                            <Border Grid.ColumnSpan="5" Style="{StaticResource Divider}" VerticalAlignment="Bottom" Margin="-14,0" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <!-- Rows that cannot be extracted (arcade) read as disabled -->
                                            <DataTrigger Binding="{Binding CanExtract}" Value="False">
                                                <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Games folder and the archive -->
            <StackPanel Grid.Row="3" Margin="24,16,24,0" IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}">
                <DockPanel>
                    <TextBlock Text="{l:T 'GAMES FOLDER'}" Style="{StaticResource Text.Overline}" Width="150" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary.Small}" Content="{l:T 'Change…'}" Command="{Binding ChangeFolderCommand}" />
                    <TextBlock Text="{Binding GamesRoot}" Style="{StaticResource Text.Mono}" Foreground="{StaticResource Brush.Text.Primary}"
                               TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock Text="{l:T AFTERWARDS}" Style="{StaticResource Text.Overline}" Width="150" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding KeepArchive, Converter={StaticResource Not}}" Content="{l:T 'Move the archive to the Recycle Bin'}" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>

            <!-- Progress -->
            <Border Grid.Row="4" Margin="24,16,24,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisible}}"
                    Background="{StaticResource Brush.Bg}" CornerRadius="{StaticResource Radius.Md}"
                    BorderBrush="{StaticResource Brush.Border.Subtle}" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="14,10,14,8">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Fraction, StringFormat={}{0:P0}}" Style="{StaticResource Text.Mono}" />
                        <TextBlock Text="{Binding Stage}" FontSize="{StaticResource Font.Size.Sm}" Foreground="{StaticResource Brush.Text.Secondary}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}" Margin="14,0" />
                    <TextBox x:Name="LogBox" Style="{StaticResource TextBox.Log}" Text="{Binding Log, Mode=OneWay}" Height="84" Padding="14,8"
                             TextChanged="LogBox_TextChanged" />
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Button Grid.Row="5" Style="{StaticResource Button.Secondary}" Command="{Binding AddFilesCommand}" HorizontalAlignment="Left"
                    Margin="24,18,24,20" IsEnabled="{Binding IsWorking, Converter={StaticResource Not}}"
                    ToolTip="{l:T 'Pick .zip or .7z games from any folder'}">
                <StackPanel Orientation="Horizontal">
                    <ui:Icon Data="{StaticResource Icon.Plus}" Width="14" Height="14" Margin="0,0,8,0" />
                    <TextBlock Text="{l:T 'Add files…'}" />
                </StackPanel>
            </Button>
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,18,24,20">
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T Cancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToCollapsed}}" />
                <Button Style="{StaticResource Button.Secondary}" Content="{l:T Close}" Command="{Binding CloseCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}" />
                <Button Style="{StaticResource Button.Primary}" Command="{Binding ExtractCommand}" IsEnabled="{Binding CanStart}" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <ui:Icon Data="{StaticResource Icon.Download}" Width="14" Height="14" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ExtractLabel}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
