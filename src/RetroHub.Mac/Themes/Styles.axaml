<!--
  Look of the Fluent controls the app keeps (context menu, tooltip, separator): only tokens, applied on top of Fluent.
  DynamicResource: these styles load before Application.Resources (Fluent has to come first, see App.axaml).
  WPF's MenuItem.Danger style is the "danger" class here: <MenuItem Classes="danger" />.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Context menu ═════════════════════════════════════════════════ -->
    <Style Selector="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Base}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Md}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="220" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Base}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource Brush.Overlay.Hover}" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Destructive menu action -->
    <Style Selector="MenuItem.danger">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
    </Style>
    <Style Selector="MenuItem.danger:pointerover /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
    </Style>

    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="6,4" />
    </Style>

    <!-- ═══ Tooltip ══════════════════════════════════════════════════════ -->
    <Style Selector="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Sm}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Sm}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MaxWidth" Value="480" />
    </Style>
    <Style Selector="ToolTip /template/ ContentPresenter">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Scrollbars: Fluent's thin auto-hiding ones, in the theme's grays -->
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource Brush.Border.Strong}" />
    </Style>
</Styles>
